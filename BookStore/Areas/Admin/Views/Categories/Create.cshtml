
@model BookStore.Models.Category

@{
    ViewBag.Title = "Thêm thể loại";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Admin/css/CategoriesCreate.css")" />
}

<div class="category-create-page">
    <div class="category-create-header">
        <h2>Thêm thể loại</h2>
        <p>Tạo thể loại mới để phân loại sách trong cửa hàng.</p>
    </div>

    <div class="category-create-card">
        @using (Html.BeginForm("Create", "Categories",
            new { area = "Admin" }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "",
                new { @class = "validation-summary" })

            <div class="category-form-group">
                @Html.LabelFor(model => model.CategoryName,
                    "Tên thể loại")

                @Html.TextBoxFor(model => model.CategoryName,
                    new
                    {
                        @class = "category-input",
                        placeholder = "Nhập tên thể loại...",
                        maxlength = "100",
                        required = "required"
                    })

                @Html.ValidationMessageFor(model => model.CategoryName,
                    "", new { @class = "field-error" })
            </div>

            <div class="category-form-actions">
                <button type="submit" class="btn-save-category">
                    <i class="fa-solid fa-plus"></i>
                    Thêm thể loại
                </button>

                <a href="@Url.Action("Index", "Categories",
                    new { area = "Admin" })"
                   class="btn-back-category">
                    Quay lại
                </a>
            </div>
        }
    </div>
</div>
