
@{
    ViewBag.Title = "Tổng quan";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/Content/Admin/css/AdminHome.css")" />
}

<div class="admin-dashboard">
    <h2>TRANG CHỦ QUẢN TRỊ</h2>
    <p class="dashboard-description">
        Thống kê tổng quan hoạt động của The Book Store
    </p>

    <div class="dashboard-grid">

        <div class="dashboard-card">
            <div class="dashboard-icon">
                <i class="fa-solid fa-book"></i>
            </div>
            <div>
                <h3>Số lượng sách</h3>
                <p>@ViewBag.BookCount</p>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-icon">
                <i class="fa-solid fa-list"></i>
            </div>
            <div>
                <h3>Số thể loại</h3>
                <p>@ViewBag.CategoryCount</p>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-icon">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <h3>Số tài khoản</h3>
                <p>@ViewBag.UserCount</p>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="dashboard-icon">
                <i class="fa-solid fa-box"></i>
            </div>
            <div>
                <h3>Số đơn hàng</h3>
                <p>@ViewBag.OrderCount</p>
            </div>
        </div>

        <div class="dashboard-card revenue-card">
            <div class="dashboard-icon">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div>
                <h3>Tổng doanh thu</h3>
                <p>@String.Format("{0:N0} đ", ViewBag.TotalRevenue)</p>
            </div>
        </div>

    </div>
</div>
