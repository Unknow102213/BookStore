
@model IEnumerable<BookStore.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/Content/Admin/css/OrdersIndex.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Admin/css/Search.css")" />
}

<div class="orders-page">
    <div class="page-heading">
        <div>
            <h2>Quản lý đơn hàng</h2>
            <p>Danh sách đơn hàng trong hệ thống.</p>
        </div>
    </div>

    <div class="admin-search">
        @using (Html.BeginForm("Index", "Orders",
            new { area = "Admin" }, FormMethod.Get))
        {
            <div class="admin-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       name="searchString"
                       value="@ViewBag.SearchString"
                       placeholder="Nhập mã đơn, email khách hàng hoặc trạng thái đơn hàng..." />
            </div>

            <button type="submit" class="btn-admin-search">
                Tìm kiếm
            </button>

            <a href="@Url.Action("Index", "Orders", new { area = "Admin" })"
               class="btn-admin-reset">
                Làm mới
            </a>
        }
    </div>

    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái đơn</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OrderID</td>

                            <td>
                                @(item.User != null
                                    ? item.User.Email
                                    : "Không xác định")
                            </td>

                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>

                            <td class="order-amount">
                                @item.TotalAmount.ToString("N0") đ
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.PaymentStatus)
                                    ? "Chưa cập nhật"
                                    : item.PaymentStatus)
                            </td>

                            <td>
                                <span class="order-status">
                                    @(string.IsNullOrEmpty(item.Status)
                                        ? "Chưa cập nhật"
                                        : item.Status)
                                </span>
                            </td>

                            <td class="order-actions">
                                @Html.ActionLink(
                                    "Chi tiết",
                                    "Details",
                                    new { id = item.OrderID })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-orders">
                            @if (!String.IsNullOrWhiteSpace(ViewBag.SearchString as string))
                            {
                                <span>Không tìm thấy đơn hàng phù hợp.</span>
                            }
                            else
                            {
                                <span>Chưa có đơn hàng nào.</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
