@model IEnumerable<BookStore.Models.Review>

@{
    ViewBag.Title = "Quản lý đánh giá";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Admin/css/ReviewsIndex.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Admin/css/Search.css")" />
}

<div class="reviews-page">
    <div class="reviews-heading">
        <div>
            <h2>Quản lý đánh giá</h2>
            <p>Xem và quản lý đánh giá sách từ khách hàng.</p>
        </div>
    </div>

    <div class="admin-search">
        @using (Html.BeginForm("Index", "Reviews",
            new { area = "Admin" }, FormMethod.Get))
        {
            <div class="admin-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       name="searchString"
                       value="@ViewBag.SearchString"
                       placeholder="Nhập mã đánh giá, tên sách hoặc số sao..." />
            </div>

            <button type="submit" class="btn-admin-search">
                Tìm kiếm
            </button>

            <a href="@Url.Action("Index", "Reviews", new { area = "Admin" })"
               class="btn-admin-reset">
                Làm mới
            </a>
        }
    </div>

    <div class="reviews-panel">
        <div class="reviews-table-wrapper">
            <table class="reviews-table">
                <thead>
                    <tr>
                        <th>Mã đánh giá</th>
                        <th>Tên sách</th>
                        <th>Email khách hàng</th>
                        <th>Đánh giá</th>
                        <th>Thời gian</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.ReviewID</td>
                                <td class="review-book">
                                    @(item.Book != null ? item.Book.Title : "Không xác định")
                                </td>
                                <td>
                                    @(item.User != null ? item.User.Email : "Không xác định")
                                </td>
                                <td>
                                    <span class="review-rating">
                                        <i class="fa-solid fa-star"></i>
                                        @item.Rating/5
                                    </span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CreatedAt)
                                </td>
                                <td>
                                    <div class="review-actions">
                                        @Html.ActionLink(
                                            "Chi tiết",
                                            "Details",
                                            new { id = item.ReviewID },
                                            new { @class = "review-btn review-btn-details" }
                                        )

                                        @Html.ActionLink(
                                            "Xóa",
                                            "Delete",
                                            new { id = item.ReviewID },
                                            new { @class = "review-btn review-btn-delete" }
                                        )
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="reviews-empty">
                                @if (!String.IsNullOrWhiteSpace(ViewBag.SearchString as string))
                                {
                                    <span>Không tìm thấy đánh giá phù hợp.</span>
                                }
                                else
                                {
                                    <span>Chưa có đánh giá nào.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>