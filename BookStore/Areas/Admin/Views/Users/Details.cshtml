
@model BookStore.Models.User

@{
    ViewBag.Title = "Chi tiết tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/Content/Admin/css/UserDetails.css")" />
}

<div class="user-details-page">

    <div class="page-heading">
        <div>
            <h2>Chi tiết tài khoản</h2>
            <p>Thông tin chi tiết của tài khoản trong hệ thống.</p>
        </div>
    </div>

    <div class="user-details-card">

        <div class="user-details-header">
            <div class="user-avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <div>
                <h3>
                    @(string.IsNullOrWhiteSpace(Model.FullName)
                    ? "Chưa cập nhật họ tên"
                    : Model.FullName)
                </h3>
                <p>Mã tài khoản: @Model.UserID</p>
            </div>
        </div>

        <div class="user-details-grid">

            <div class="user-detail-item">
                <span class="detail-label">Email</span>
                <span class="detail-value">@Model.Email</span>
            </div>

            <div class="user-detail-item">
                <span class="detail-label">Số điện thoại</span>
                <span class="detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Phone)
                        ? "Chưa cập nhật"
                        : Model.Phone)
                </span>
            </div>

            <div class="user-detail-item">
                <span class="detail-label">Vai trò</span>
                <span class="detail-value">
                    @(Model.Role == "A" ? "Quản trị viên" : "Khách hàng")
                </span>
            </div>

            <div class="user-detail-item">
                <span class="detail-label">Trạng thái</span>
                <span class="detail-value">
                    @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")
                </span>
            </div>

            <div class="user-detail-item">
                <span class="detail-label">Ngày tạo tài khoản</span>
                <span class="detail-value">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>

            <div class="user-detail-item user-detail-address">
                <span class="detail-label">Địa chỉ</span>
                <span class="detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Address)
                        ? "Chưa cập nhật"
                        : Model.Address)
                </span>
            </div>

        </div>

        <div class="user-details-actions">
            @Html.ActionLink(
                "Quay lại",
                "Index",
                null,
                new { @class = "btn-user-back" }
            )

            @Html.ActionLink(
                "Chỉnh sửa",
                "Edit",
                new { id = Model.UserID },
                new { @class = "btn-user-edit" }
            )
        </div>

    </div>
</div>
