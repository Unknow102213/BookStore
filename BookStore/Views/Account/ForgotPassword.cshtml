@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/Customer/css/Account.css")" />
}

<main class="account-page">
    <div class="account-container account-forgot">
        <div class="account-banner">
            <img src="@Url.Content("~/Content/img/banner_login_register.png")"
                 alt="The Book Store" />
        </div>

        <section class="account-form-area">
            <h1 class="account-heading">Quên mật khẩu?</h1>

            <p class="account-description">
                Nhập email đã đăng ký để tiếp tục khôi phục tài khoản.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="account-message error">
                    @ViewBag.Error
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="account-message success">
                    @TempData["Success"]
                </div>
            }

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post,
                new { @class = "account-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="account-field">
                    <label for="email">Email đăng ký</label>
                    <input type="email"
                           id="email"
                           name="email"
                           maxlength="255"
                           autocomplete="email"
                           required />
                </div>

                <button type="submit" class="account-submit">
                    Xác nhận email
                </button>
            }

            <div class="account-links">
                @Html.ActionLink("Quay lại đăng nhập", "Login", "Account")
            </div>
        </section>
    </div>
</main>
