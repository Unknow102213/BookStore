
@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/Content/Customer/css/Account.css")" />
}

<main class="account-page">
    <div class="account-container account-register">        
        <div class="account-banner">
            <img src="@Url.Content("~/Content/img/banner_login_register.png")"
                 alt="Chào mừng đến với The Book Store" />
        </div>

        <section class="account-form-area">
            <h1 class="account-heading">Tạo tài khoản</h1>

            <p class="account-description">
                Đăng ký để khám phá thế giới sách cùng chúng tôi.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="account-message error">
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("Register", "Account", FormMethod.Post,
                new { @class = "account-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="account-field">
                    <label for="fullName">Họ và tên</label>
                    <input type="text"
                           id="fullName"
                           name="fullName"
                           maxlength="100"
                           autocomplete="name"
                           required />
                </div>

                <div class="account-field">
                    <label for="email">Email</label>
                    <input type="email"
                           id="email"
                           name="email"
                           maxlength="255"
                           autocomplete="email"
                           required />
                </div>

                <div class="account-field">
                    <label for="password">Mật khẩu</label>
                    <input type="password"
                           id="password"
                           name="password"
                           minlength="8"
                           maxlength="72"
                           autocomplete="new-password"
                           required />
                </div>

                <div class="account-field">
                    <label for="confirmPassword">Xác nhận mật khẩu</label>
                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           minlength="8"
                           maxlength="72"
                           autocomplete="new-password"
                           required />
                </div>

                <button type="submit" class="account-submit">
                    Đăng ký
                </button>
            }

            <div class="account-links">
                Đã có tài khoản?
                @Html.ActionLink("Đăng nhập", "Login", "Account")
            </div>
        </section>

    </div>
</main>
