@model BookStore.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/Content/Customer/css/Account.css")" />
}

<main class="account-page">
    <div class="account-container account-register">
        <div class="account-banner">
            <img src="@Url.Content("~/Content/img/banner_login_register.png")"
                 alt="Chào mừng đến với The Book Store" />
        </div>

        <section class="account-form-area">
            <h1 class="account-heading">Tạo tài khoản</h1>

            <p class="account-description">
                Đăng ký để khám phá thế giới sách cùng chúng tôi.
            </p>

            @Html.ValidationSummary(false, "", new { @class = "account-message error" })

            @if (ViewBag.Error != null)
            {
                <div class="account-message error">
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("Register", "Account", FormMethod.Post,
                new { @class = "account-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="account-field">
                    @Html.LabelFor(m => m.FullName, "Họ và tên")
                    @Html.TextBoxFor(m => m.FullName, new
                    {
                        maxlength = "100",
                        autocomplete = "name"
                    })
                    @Html.ValidationMessageFor(m => m.FullName)
                </div>

                <div class="account-field">
                    @Html.LabelFor(m => m.Email, "Email")
                    @Html.TextBoxFor(m => m.Email, new
                    {
                        type = "email",
                        maxlength = "255",
                        autocomplete = "email"
                    })
                    @Html.ValidationMessageFor(m => m.Email)
                </div>

                <div class="account-field">
                    @Html.LabelFor(m => m.Password, "Mật khẩu")
                    @Html.PasswordFor(m => m.Password, new
                    {
                        minlength = "8",
                        maxlength = "72",
                        autocomplete = "new-password"
                    })
                    @Html.ValidationMessageFor(m => m.Password)
                </div>

                <div class="account-field">
                    @Html.LabelFor(m => m.ConfirmPassword, "Xác nhận mật khẩu")
                    @Html.PasswordFor(m => m.ConfirmPassword, new
                    {
                        autocomplete = "new-password"
                    })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword)
                </div>

                <button type="submit" class="account-submit">
                    Đăng ký
                </button>
            }

            <div class="account-links">
                Đã có tài khoản?
                @Html.ActionLink("Đăng nhập", "Login", "Account")
            </div>
        </section>

    </div>
</main>
