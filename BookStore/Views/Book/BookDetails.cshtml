@model BookStore.ViewModels.BookDetailsViewModel

@{
    ViewBag.Title = "Chi tiết sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Content/Customer/css/BookDetails.css")" rel="stylesheet" />
}

<div class="book-details-page">
    <div class="book-details-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a href="@Url.Action("BookIndex", "Book")">Danh sách sách</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span>Chi tiết sách</span>
    </div>

    <div class="book-details-container">
        <div class="book-details-image">
            @if (!string.IsNullOrWhiteSpace(Model.Book.ImageURL))
            {
                <img src="@Url.Content(Model.Book.ImageURL)" alt="@Model.Book.Title" />
            }
            else
            {
                <div class="book-image-placeholder">
                    <i class="fa-solid fa-book-open"></i>
                    <span>Chưa có ảnh bìa</span>
                </div>
            }
        </div>

        <div class="book-details-info">
            <span class="book-details-label">THÔNG TIN SÁCH</span>

            <h1>@Model.Book.Title</h1>

            <div class="book-details-meta">
                <p>
                    <span>Tác giả:</span>
                    @(string.IsNullOrWhiteSpace(Model.Book.AuthorName) ? "Chưa cập nhật" : Model.Book.AuthorName)
                </p>

                <p>
                    <span>Thể loại:</span>
                    @(Model.Book.Category == null ? "Chưa phân loại" : Model.Book.Category.CategoryName)
                </p>
            </div>

            <div class="book-details-price">
                @Model.Book.Price.ToString("N0") đ
            </div>

            <div class="book-details-stock">
                @if (Model.Book.StockQuantity > 0)
                {
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Còn hàng (@Model.Book.StockQuantity cuốn)</span>
                }
                else
                {
                    <i class="fa-solid fa-circle-xmark"></i>
                    <span>Hết hàng</span>
                }
            </div>

            <div class="book-details-divider"></div>

            <div class="book-details-description">
                <h3>Giới thiệu sách</h3>

                @if (string.IsNullOrWhiteSpace(Model.Book.Description))
                {
                    <p>Chưa có thông tin giới thiệu cho cuốn sách này.</p>
                }
                else
                {
                    <p>@Model.Book.Description</p>
                }
            </div>

            <div class="book-details-actions">
                @if (Model.Book.StockQuantity > 0)
                {
                    using (Html.BeginForm("AddBookDetailsToCart", "Cart", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.BookID)

                        <div class="book-quantity-control">
                            <button type="button" onclick="changeBookQuantity(-1)">
                                <i class="fa-solid fa-minus"></i>
                            </button>

                            @Html.TextBoxFor(m => m.Quantity, new
                            {
                                type = "number",
                                id = "book-quantity",
                                min = "1",
                                max = Model.Book.StockQuantity
                            })

                            <button type="button" onclick="changeBookQuantity(1)">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>

                        if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <p class="book-error-message">@Model.ErrorMessage</p>
                        }

                        <div class="book-submit-actions">
                            <button type="submit" class="book-add-cart">
                                <i class="fa-solid fa-cart-shopping"></i>
                                Thêm vào giỏ hàng
                            </button>

                            <a class="book-back-button" href="@Url.Action("BookIndex", "Book")">
                                Quay lại danh sách
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="book-submit-actions">
                        <button type="button" class="book-add-cart" disabled>
                            <i class="fa-solid fa-cart-shopping"></i>
                            Hết hàng
                        </button>

                        <a class="book-back-button" href="@Url.Action("BookIndex", "Book")">
                            Quay lại danh sách
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Danh gia sach -->
    <div class="book-reviews-section">
        <div class="book-reviews-header">
            <div>
                <span class="book-reviews-label">ĐÁNH GIÁ TỪ KHÁCH HÀNG</span>
                <h2>Đánh giá sách</h2>
            </div>
        </div>

        <div class="book-reviews-summary">
            <div class="book-reviews-average">
                <strong>@Model.ReviewInfo.AverageRating.ToString("0.0")</strong>
                <div class="book-review-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(Model.ReviewInfo.AverageRating))
                        {
                            <i class="fa-solid fa-star"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-star"></i>
                        }
                    }
                </div>
                <span>@Model.ReviewInfo.TotalReviews đánh giá</span>
            </div>

            <div class="book-reviews-summary-text">
                @if (Model.ReviewInfo.TotalReviews > 0)
                {
                    <p>Điểm đánh giá được tính từ những khách hàng đã nhận sách.</p>
                }
                else
                {
                    <p>Cuốn sách này chưa có đánh giá nào.</p>
                }
            </div>
        </div>

        @if (Model.ReviewInfo.Reviews != null && Model.ReviewInfo.Reviews.Any())
        {
            <div class="book-review-list">
                @foreach (var review in Model.ReviewInfo.Reviews)
                {
                    <div class="book-review-item">
                        <div class="book-review-top">
                            <div class="book-review-avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>

                            <div class="book-review-user">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(review.FullName)
                                        ? "Khách hàng"
                                        : review.FullName)
                                </strong>

                                <span>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>

                        <div class="book-review-rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            }
                        </div>

                        <p class="book-review-comment">
                            @review.Comment
                        </p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="book-review-empty">
                <i class="fa-regular fa-comment-dots"></i>
                <p>Chưa có khách hàng nào đánh giá cuốn sách này.</p>
            </div>
        }
    </div>
</div>

<script>
    function changeBookQuantity(amount) {
        var input = document.getElementById("book-quantity");

        var currentQuantity = parseInt(input.value) || 1;
        var minQuantity = parseInt(input.min);
        var maxQuantity = parseInt(input.max);

        var newQuantity = currentQuantity + amount;

        if (newQuantity < minQuantity) {
            newQuantity = minQuantity;
        }

        if (newQuantity > maxQuantity) {
            newQuantity = maxQuantity;
        }

        input.value = newQuantity;
    }
</script>