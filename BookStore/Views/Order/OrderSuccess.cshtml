@model BookStore.Models.Order

@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/Content/Customer/css/OrderSuccess.css")" />
}

<main class="order-success-page">

    <div class="success-container">

        <div class="success-icon">
            <i class="fa-solid fa-check"></i>
        </div>

        <h1>Đặt hàng thành công!</h1>

        <p class="success-message">
            Cảm ơn bạn đã mua sắm tại The Book Store.
            Đơn hàng của bạn đã được ghi nhận và đang chờ xác nhận.
        </p>

        <div class="order-info">

            <div class="order-info-row">
                <span>Mã đơn hàng</span>
                <strong>#@Model.OrderID</strong>
            </div>

            <div class="order-info-row">
                <span>Ngày đặt hàng</span>
                <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>

            <div class="order-info-row">
                <span>Người nhận</span>
                <strong>@Model.ReceiverName</strong>
            </div>

            <div class="order-info-row">
                <span>Số điện thoại</span>
                <strong>@Model.ReceiverPhone</strong>
            </div>

            <div class="order-info-row">
                <span>Phương thức thanh toán</span>
                <strong>Thanh toán khi nhận hàng (COD)</strong>
            </div>

            <div class="order-info-row total-row">
                <span>Tổng thanh toán</span>
                <strong>
                    @Model.TotalAmount.ToString("N0") VNĐ
                </strong>
            </div>

        </div>

        <div class="success-actions">

            <a href="@Url.Action("OrderHistory", "Order")"
               class="btn-order-history">
                <i class="fa-solid fa-receipt"></i>
                Xem lịch sử đơn hàng
            </a>

            <a href="@Url.Action("Index", "Home")"
               class="btn-continue-shopping">
                Tiếp tục mua sắm
            </a>

        </div>

    </div>

</main>