
@model BookStore.Models.Book

<article class="home-book-card">
    <a class="home-book-image"
       href="@Url.Action("BookDetails", "Book", new { id = Model.BookID })">
        <img src="@Url.Content(
            string.IsNullOrWhiteSpace(Model.ImageURL)
                ? "~/Content/img/no-book-image.png"
                : Model.ImageURL)"
             alt="@Model.Title"
             loading="lazy" />
    </a>

    <div class="home-book-info">
        <a class="home-book-title"
           href="@Url.Action("BookDetails", "Book", new { id = Model.BookID })">
            @Model.Title
        </a>

        <a class="home-book-author"
           href="@Url.Action("BookDetails", "Book", new { id = Model.BookID })">
            @Model.AuthorName
        </a>

        <a class="home-book-price"
           href="@Url.Action("BookDetails", "Book", new { id = Model.BookID })">
            @Model.Price.ToString("N0") đ
        </a>

        @if (Model.IsActive && Model.StockQuantity > 0)
        {
            <button type="button"
                    class="home-add-cart"
                    data-open-cart-modal="@Model.BookID">
                <i class="fa-solid fa-cart-shopping"></i>
                Thêm vào giỏ hàng
            </button>
        }
        else
        {
            <button type="button" class="home-add-cart" disabled>
                Hết hàng
            </button>
        }
    </div>

    <a class="home-book-overlay"
       href="@Url.Action("BookDetails", "Book", new { id = Model.BookID })"
       aria-label="Xem chi tiết @Model.Title">
    </a>
</article>

<div class="cart-modal"
     id="cart-modal-@Model.BookID"
     aria-hidden="true">

    <div class="cart-modal-backdrop" data-close-cart-modal></div>

    <div class="cart-modal-content"
         role="dialog"
         aria-modal="true"
         aria-labelledby="cart-modal-title-@Model.BookID">

        <button type="button"
                class="cart-modal-close"
                data-close-cart-modal
                aria-label="Đóng">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h3 id="cart-modal-title-@Model.BookID">Thêm vào giỏ hàng</h3>


        <div class="cart-modal-book">
            <div class="cart-modal-book-image">
                <img src="@Url.Content(
            string.IsNullOrWhiteSpace(Model.ImageURL)
                ? "~/Content/img/no-book-image.png"
                : Model.ImageURL)"
                     alt="@Model.Title" />
            </div>

            <div class="cart-modal-book-details">
                <p class="cart-modal-book-title">@Model.Title</p>

                <p class="cart-modal-price">
                    @Model.Price.ToString("N0") đ
                </p>

                <p class="cart-modal-stock"
                   data-stock="@Model.StockQuantity">
                    Còn @Model.StockQuantity cuốn trong kho
                </p>
            </div>
        </div>


        <div class="cart-modal-quantity">
            <button type="button"
                    data-quantity-change="-1"
                    aria-label="Giảm số lượng">
                <i class="fa-solid fa-minus"></i>
            </button>

            <input type="number"
                   class="cart-modal-quantity-input"
                   value="1"
                   min="1"
                   max="@Model.StockQuantity"
                   aria-label="Số lượng sách" />

            <button type="button"
                    data-quantity-change="1"
                    aria-label="Tăng số lượng">
                <i class="fa-solid fa-plus"></i>
            </button>
        </div>

        <p class="cart-modal-subtotal">
            Tạm tính:
            <strong data-subtotal="@Model.Price.ToString(
                System.Globalization.CultureInfo.InvariantCulture)">
                @Model.Price.ToString("N0") đ
            </strong>
        </p>

        @using (Html.BeginForm("AddToCart", "Cart",
            new { id = Model.BookID },
            FormMethod.Post,
            new { @class = "cart-modal-form" }))
        {
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="quantity"
                   value="1" />

            <button type="submit" class="cart-modal-submit">
                <i class="fa-solid fa-cart-plus"></i>
                Xác nhận thêm vào giỏ
            </button>
        }

        <p class="cart-modal-error" role="alert"></p>
    </div>
</div>
